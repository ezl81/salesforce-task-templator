<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId"
    access="global" controller="CasesOnObjectController">
    <aura:handler name="init" value="{! this }" action="{! c.doInit }" />
    <aura:handler event="force:refreshView" action="{! c.doInit }" />
    <aura:attribute name="CaseLinkedField" type="String" access="global" />
    <aura:attribute name="CaseListOfSummaries" type="Object" />


    <lightning:card title="Simply Tasks Cases">

        <aura:if isTrue="{! v.CaseListOfSummaries.length > 0 }">
        
            <lightning:accordion aura:id="accordion" allowMultipleSectionsOpen="true">
        
                <aura:iteration items="{!v.CaseListOfSummaries}" var="caseList">
        
                    <lightning:accordionSection label="{! caseList.parentCaseName }">
        
                        <lightning:layout multipleRows="true">
        
                            <lightning:layoutItem size="12">
        
                                <lightning:layout>
                                    <lightning:layoutItem size="12" padding="around-small">
                                        <span style="font-size:1.2em;font-weight: bold;">Overall Progress ({!
                                            caseList.parentCaseName })</span>
                                        <lightning:progressBar aura:Id="OverallProgress" title="{! caseList.label }"
                                            value="{! caseList.overallPercentComplete }" />
                                    </lightning:layoutItem>
                                </lightning:layout>
        
                            </lightning:layoutItem>
        
                            <aura:iteration items="{! caseList.summaries }" var="item">
                                <lightning:layoutItem size="12" padding="around-small">
                                    <lightning:layout>
                                        <lightning:layoutItem size="1">
                                            &nbsp;
                                            <aura:if isTrue="{! item.isCurrentCase }">
                                                Here
                                                <lightning:icon iconName="utility:level_down" alternativeText="Current Case" />
                                            </aura:if>
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="{! item.indent }">
                                            &nbsp;
                                        </lightning:layoutItem>
                                        <lightning:layoutItem size="{! 11 - item.indent }">
                                            <a href="{! item.caseUrl }">{! item.caseName }</a>
                                            <lightning:progressBar aura:Id="{! item.id }" title="{! item.compositePct + '%' }"
                                                value="{! item.compositePct }" />
                                            {! item.compositeLabel }
                                        </lightning:layoutItem>
                                    </lightning:layout>
        
                                </lightning:layoutItem>
        
                            </aura:iteration>
        
                        </lightning:layout>
        
                    </lightning:accordionSection>
        
                </aura:iteration>
        
            </lightning:accordion>
        
            <aura:set attribute="else">
                No Task Tracker Cases Found
            </aura:set>
        
        </aura:if>
    </lightning:card>

</aura:component>